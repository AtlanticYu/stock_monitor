# Default container storage uses the platform Supabase REST API; no MySQL password.
SPRING_PROFILES_ACTIVE=platform,supabase
PORT=8080
CONTEXT_PATH=/zhoubao
SUPABASE_URL=https://workspace.sy.soyoung.com/supabase
SUPABASE_SCHEMA=u_yuzhengxin
# SUPABASE_ANON_KEY defaults to the platform's public browser key.
# Users log in with their own Supabase Auth email/password; tokens enforce RLS.
# To use MySQL instead, activate only platform and provide:
# DB_URL=jdbc:mysql://MYSQL_HOST:3306/stocks_monitor_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false
# DB_USERNAME=
# DB_PASSWORD=
# APP_USERNAME=admin
# APP_PASSWORD=
COOKIE_SECURE=true
