# Copy to .env; replace all three blank passwords before docker compose up.
# Local JVM/IDE username; Compose uses its own dedicated stocks account.
DB_USERNAME=stocks
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_USERNAME=admin
APP_PASSWORD=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# For hosting below /zhoubao set CONTEXT_PATH=/zhoubao and access /zhoubao/.
CONTEXT_PATH=
COOKIE_SECURE=false
MARKET_ENABLED=true
